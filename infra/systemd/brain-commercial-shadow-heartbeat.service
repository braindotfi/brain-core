[Unit]
Description=Refresh Brain internal commercial shadow scheduler heartbeat
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=azureuser
WorkingDirectory=/home/azureuser/brain-core
ExecStart=/home/azureuser/brain-core/scripts/ops/run-commercial-shadow-scheduler.sh heartbeat
TimeoutStartSec=5m
NoNewPrivileges=true
PrivateTmp=true
