# Brain production-mode env template (testnet dev-live, Base Sepolia).
#
#   cp .env.prod.example .env.prod   then fill in the REQUIRED values.
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# This single file is used two ways:
#   • compose interpolation (the ${VAR} refs in docker-compose.prod.yml — DB and
#     MinIO passwords woven into connection URLs) — needs `--env-file .env.prod`.
#   • the api/agents container env_file (the app secrets the process reads).
#
# Values marked REQUIRED have no safe default. Compose refuses to render
# production DB and MinIO credentials when unset or empty, and the app refuses to
# boot in NODE_ENV=production if any DB or infra secret uses a known weak
# default.

# ─────────────────────────────────────────────────────────────────────────────
# Service identity (what GET /health reports). Without these the api falls back
# to the code defaults "brain-unknown" / "0.0.0-dev", so /health is meaningless.
# docker-compose.prod.yml sets SERVICE_NAME. SERVICE_VERSION is baked into the
# image at build time (git describe; see Dockerfile + main.yml) and is the single
# source of truth for /health. Do NOT set SERVICE_VERSION here — an env_file value
# overrides the image ENV and would re-pin a stale version. @brain/sdk versions
# independently.
# ─────────────────────────────────────────────────────────────────────────────
SERVICE_NAME=brain-api

# ─────────────────────────────────────────────────────────────────────────────
# Infrastructure passwords (REQUIRED, compose interpolation woven into DB URLs)
# Generate a distinct high-entropy value for every password below. Do not use
# the role name, "brain", "postgres", "changeme", or "password".
# ─────────────────────────────────────────────────────────────────────────────
# Postgres bootstrap superuser/owner (migrate connects as this role).
POSTGRES_PASSWORD=
# Application roles created by infra/db-roles.sql.
BRAIN_APP_DB_PASSWORD=
BRAIN_PRIVILEGED_DB_PASSWORD=
BRAIN_WIKI_DB_PASSWORD=
BRAIN_MCP_READER_DB_PASSWORD=
BRAIN_RAW_WORKER_DB_PASSWORD=
BRAIN_CANONICAL_PROJECTOR_DB_PASSWORD=
BRAIN_LEDGER_PROJECTOR_DB_PASSWORD=
BRAIN_EXECUTION_WORKER_DB_PASSWORD=
BRAIN_AUDIT_VERIFIER_DB_PASSWORD=
BRAIN_AUDIT_PUBLISHER_DB_PASSWORD=
BRAIN_RESOLVER_DB_PASSWORD=
BRAIN_TENANT_DELETION_DB_PASSWORD=
BRAIN_SURFACE_GATEWAY_DB_PASSWORD=
BRAIN_SURFACE_GATEWAY_AUDIT_DB_PASSWORD=
# The OAuth authorization server (services/auth, Phase 2a): brain_auth is the
# tenant-scoped request-path role, brain_auth_audit_writer is its INSERT-only
# audit_events connection (mirrors BRAIN_SURFACE_GATEWAY_AUDIT_DB_PASSWORD).
BRAIN_AUTH_DB_PASSWORD=
BRAIN_AUTH_AUDIT_DB_PASSWORD=
# Default false: a missing BRAIN_MCP_READER_DB_URL fails boot in
# NODE_ENV=production, same as the other DB-isolation URLs. Set true only as
# a conscious operator opt-out, it warns instead and boots with the MCP
# raw-artifact reader (raw.artifact.get) disabled.
BRAIN_ALLOW_MISSING_MCP_READER=false
# MinIO root credentials (also used as the S3 access key id / secret).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Blob bucket name and S3 region (MinIO ignores region but the SDK requires one).
BLOB_CONTAINER=brain-artifacts
S3_REGION=us-east-1

# ─────────────────────────────────────────────────────────────────────────────
# C1 — Auth / JWKS (REQUIRED — production has no demo-token path)
#
# The `auth` service publishes the PUBLIC half of AUTH_SIGN_KEY at its own
# /.well-known/jwks.json; the API verifies against it. So you only set the
# private signing key here -- AUTH_JWKS_URL is wired in compose to the
# in-network auth service (http://auth:3000/.well-known/jwks.json), don't set
# it. (Before Phase 4 this pointed at a separate static-JWKS sidecar; that
# sidecar has been retired.)
#
# This makes every service's token verification contingent on `auth` actually
# booting -- and `auth` has its own hard, unflaggable boot fence on the
# EMAIL_ENDPOINT/EMAIL_API_KEY pair (see C8 item 3 below): if those are blank,
# `auth` cannot boot, and api/worker/surface-gateway cannot verify any token --
# a total authentication outage, not a degraded side feature.
#
# Generate AUTH_SIGN_KEY (a private RS256 JWK, one line) with:
#   pnpm --filter @brain/static-jwks run generate
# Keep it secret. The same key signs SIWX tokens and mints test JWTs:
#   AUTH_SIGN_KEY='{...}' pnpm --filter @brain/dev-token start -- --tenant tnt_… --principal user_…
# ─────────────────────────────────────────────────────────────────────────────
AUTH_SIGN_KEY=
# iss/aud — must match what dev-token sets (these are the defaults it uses).
AUTH_ISSUER=https://auth.brain.fi
AUTH_AUDIENCE=brain-api

# services/auth (Phase 2a): signs the AS session cookie, the pending-
# authorization blob, and the CSRF token (shared/src/auth/hmac-token.ts).
# 32 random bytes, base64url. Do NOT reuse AUTH_SIGN_KEY -- that is a JWT
# signing key, this is a plain HMAC secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_COOKIE_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# C2 — Source-credential encryption (AES-256-GCM key for Plaid tokens etc. at rest)
#
# VERIFIED BEHAVIOUR in NODE_ENV=production (shared/src/crypto/aes-gcm.ts):
#   • Azure Key Vault is the ONLY production-valid key source — set both
#     BRAIN_AZURE_KEY_VAULT_URL and BRAIN_SOURCE_CREDENTIAL_KEY_VAULT_NAME.
#   • BRAIN_SOURCE_CREDENTIAL_KEY (the env-var key) is FORBIDDEN in production —
#     setting it makes the API THROW AT BOOT. Leave it UNSET here. (It is only
#     for NODE_ENV != production.)
#   • With neither set, the API boots fine with NO credential encryption; the
#     only thing that fails (lazily) is STORING a real source credential. The
#     testnet demo path stores none, so leaving all of these blank is correct.
#
# Testnet default: leave ALL of the below blank (no real source ingestion).
# To enable Plaid/real source linking later, provision an Azure Key Vault and
# set the two KMS vars — or add a non-Azure escape hatch in aes-gcm.ts.
# ─────────────────────────────────────────────────────────────────────────────
# BRAIN_AZURE_KEY_VAULT_URL=https://<vault>.vault.azure.net
# BRAIN_SOURCE_CREDENTIAL_KEY_VAULT_NAME=<secret-name>
# BRAIN_SOURCE_CREDENTIAL_KEY=        # DO NOT set in production — boot fence throws

# ─────────────────────────────────────────────────────────────────────────────
# C4 — On-chain settlement + audit anchoring (Base Sepolia)
# ─────────────────────────────────────────────────────────────────────────────
BASE_RPC_URL=
# 64-hex session key (no 0x prefix) used to sign onchain_base settlements.
BRAIN_SESSION_KEY=
BRAIN_ONCHAIN_SMART_ACCOUNT=
# Audit Merkle anchor publisher (on-chain anchoring).
AUDIT_PUBLISHER_KEY=
AUDIT_ANCHOR_ADDRESS=
AUDIT_ANCHOR_FROM_BLOCK=

# ─────────────────────────────────────────────────────────────────────────────
# C5 — Contract addresses (use docs/deployment-2026-05-11.txt — the live set)
# ─────────────────────────────────────────────────────────────────────────────
POLICY_REGISTRY_ADDRESS=
MCP_AGENT_REGISTRY_ADDRESS=

# ─────────────────────────────────────────────────────────────────────────────
# C6 — Python reasoning agents (only needed with `--profile agents`)
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_OCR_MODEL=gpt-4o
# API to agents URL. Leave empty unless the agents profile is running.
DOCUMENT_EXTRACT_AGENT_URL=
# Shared secret the api uses to sign inbound calls to the agents (HMAC).
BRAIN_AGENTS_INBOUND_SECRET=
# Token the agents present back to the Brain API.
BRAIN_API_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# C7 — BrainSaaS Playground provisioning route (/v1/demo/provision-run)
#
# Powers the public playground: mints a READ+PROPOSE JWT and seeds a demo tenant.
# Boot fence (services/api/src/composition/demo-provision-fence.ts):
#   • If ENABLED=true, BRAIN_DEMO_PROVISION_SECRET is REQUIRED (the route is NOT
#     skipAuth — callers must send header `X-Demo-Provision-Auth: <secret>`).
#   • In NODE_ENV=production, ENABLED=true ALSO requires
#     BRAIN_DEMO_PROVISION_TESTNET_ATTESTED=true, or the api refuses to boot.
# Leave ENABLED=false to keep the route unregistered (fence inert).
# ─────────────────────────────────────────────────────────────────────────────
BRAIN_DEMO_PROVISION_ENABLED=false
BRAIN_DEMO_PROVISION_SECRET=
BRAIN_DEMO_PROVISION_TESTNET_ATTESTED=false

# ─────────────────────────────────────────────────────────────────────────────
# BFF service-token mint — POST /v1/auth/service-token (per-user prod tenants).
#   • Production counterpart to provision-run for a TRUSTED backend-for-frontend.
#   • If ENABLED=true, BRAIN_SERVICE_TOKEN_SECRET is REQUIRED (callers send
#     X-Service-Token-Auth equal to it); on NODE_ENV=production you also MUST set
#     BRAIN_SERVICE_TOKEN_TESTNET_ATTESTED=true, or the api refuses to boot.
#   • Minted scope ceiling = reads + propose ONLY (no approve / execute / audit
#     admin / policy write). Leave ENABLED=false to keep the route unregistered.
# ─────────────────────────────────────────────────────────────────────────────
BRAIN_SERVICE_TOKEN_ENABLED=false
BRAIN_SERVICE_TOKEN_SECRET=
BRAIN_SERVICE_TOKEN_TESTNET_ATTESTED=false

# ─────────────────────────────────────────────────────────────────────────────
# Tenant API keys - direct bearer brain_sk_test_/brain_sk_live_ credentials.
# If ENABLED=true, BRAIN_API_KEY_PEPPER is REQUIRED. Store it in Key Vault and
# rotate only with an explicit migration plan because existing key hashes depend
# on it. Rate limits are per key.
# ─────────────────────────────────────────────────────────────────────────────
BRAIN_API_KEY_AUTH_ENABLED=false
BRAIN_API_KEY_PEPPER= # gitleaks:allow
BRAIN_API_KEY_RATE_LIMIT=600
BRAIN_API_KEY_RATE_WINDOW_SECONDS=60

# ─────────────────────────────────────────────────────────────────────────────
# C8 — Email delivery (EMAIL_ENDPOINT/EMAIL_API_KEY/EMAIL_FROM are shared by
# THREE independent consumers — read all three before assuming these are inert)
#
# 1. services/api — self-serve tenant signup (POST /v1/signup), gated by
#    BRAIN_SELF_SERVE_SIGNUP below, NOT by EMAIL_ENABLED. In NODE_ENV=production
#    the verification token is never returned in the response, so it must be
#    emailed. Boot fence (services/api/src/onboarding/email-delivery.ts, wired
#    in main.ts): if BRAIN_SELF_SERVE_SIGNUP=true and NODE_ENV=production, the
#    api THROWS AT BOOT unless EMAIL_ENDPOINT and EMAIL_API_KEY are both set.
#    Leave BRAIN_SELF_SERVE_SIGNUP=false to keep the api signup routes
#    unregistered and these vars unnecessary for the api service.
#
#    services/api also uses these (unconditionally, no flag) to send a
#    production tenant founder's set-password invite from POST /v1/tenants
#    (production-tenancy/routes.ts). Lenient, not a boot fence: a missing pair
#    leaves the founder's invite unsent (visible in the tenant.created audit
#    event's founder_invite_email output and the route's response body),
#    never fails tenant creation.
#
# 2. services/surface-gateway — email approval onboarding (Slack/Teams/email
#    surfaces). The surface-gateway container reads these same vars from
#    .env.prod via compose interpolation (docker-compose.prod.yml). Each
#    surface is OFF by default, so the whole cluster is inert on the testnet
#    stack. Boot fence (services/surface-gateway/src/main.ts): when
#    EMAIL_ENABLED=true the process calls required() on EMAIL_ENDPOINT and
#    EMAIL_API_KEY and THROWS AT BOOT if either is blank ("Missing required
#    env var …"). EMAIL_FROM is optional (the per-tenant sender falls back to
#    it).
#
# 3. services/auth (Phase 2a) — POST /forgot-password sends a set-password
#    reset link. Unlike the other two, this is a hard boot fence with NO flag
#    to opt out: the auth container reads these same vars from .env.prod via
#    compose interpolation (docker-compose.prod.yml's `auth` service) and
#    THROWS AT BOOT (services/auth/src/email.ts) if either is blank, since
#    /forgot-password is registered unconditionally. Prod currently has ZERO
#    EMAIL_* keys set, which is a known gap an operator must close before
#    promoting this phase. Since Phase 4 (see C1 above) this is no longer just
#    an auth feature gap: auth cannot boot at all without these, and every
#    other service's JWKS verification is now contingent on auth booting.
#
# Set the ESP creds whenever you flip BRAIN_SELF_SERVE_SIGNUP or EMAIL_ENABLED
# on, or before promoting services/auth's Phase 2a increment 2; otherwise
# leave all vars below as-is.
#
# (Slack/Teams follow the same _ENABLED-gated pattern with their own SLACK_*/
# TEAMS_* secrets in the compose file — likewise blank/false for testnet.)
# ─────────────────────────────────────────────────────────────────────────────
BRAIN_SELF_SERVE_SIGNUP=false
EMAIL_ENABLED=false
EMAIL_ENDPOINT=
EMAIL_API_KEY=
EMAIL_FROM=

# ─────────────────────────────────────────────────────────────────────────────
# Tuning (TESTNET DEFAULT — all have safe code defaults; override only if needed)
# ─────────────────────────────────────────────────────────────────────────────
# On-chain audit-anchor publisher cadence (ms). Code default 5000; the live box
# runs 3600000 (1h) to conserve testnet nonces/ETH.
AUDIT_ANCHOR_INTERVAL_MS=3600000
AUDIT_ANCHOR_FROM_BLOCK_LOOKBACK_BLOCKS=100000
AUDIT_ANCHOR_EVENT_SCAN_MAX_BLOCKS=2000
AUDIT_ANCHOR_GAS_SAFETY_FACTOR=2
AUDIT_ANCHOR_WALLET_BALANCE_ALERT_WEI=0
# Trailing lookback for agent cumulative-spend enforcement. Default 86400 (24h).
BRAIN_AGENT_WINDOW_LOOKBACK_SECONDS=86400
# 0x 32-byte policy-version digest the session key was granted for. Default zero.
BRAIN_ONCHAIN_POLICY_VERSION=
# BrainReputationRegistry address; presence wires reputation into PolicyService.
BRAIN_REPUTATION_REGISTRY_ADDRESS=
# Wiki Q&A models (OpenAI). Defaults: gpt-4o-mini / text-embedding-3-small.
WIKI_LLM_MODEL=gpt-4o-mini
WIKI_EMBED_MODEL=text-embedding-3-small

# ─────────────────────────────────────────────────────────────────────────────
# Demo seed (only used by the `--profile seed` one-shot — NOT for real prod)
# Populates a demo tenant + active policy + registered payment agent.
#   docker compose --env-file .env.prod -f docker-compose.prod.yml --profile seed run --rm seed
# ─────────────────────────────────────────────────────────────────────────────
# ETH address the seeded "AWS" counterparty resolves to (onchain_transfer target).
BRAIN_DEMO_ONCHAIN_RECIPIENT=
# Set to false to seed data only (skip the demo policy + agent).
BRAIN_SEED_DEMO_GOVERNANCE=true
