(edge_security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

(api_docs_csp) {
	@docs path /v1/docs /v1/docs/*
	header @docs {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
	}
}

api.brain.fi {
	import edge_security_headers
	import api_docs_csp

	redir / /v1/docs 302
	reverse_proxy api:3000
}

mcp.brain.fi {
	import edge_security_headers

	@mcp path /
	handle @mcp {
		rewrite * /v1/agents/mcp
		reverse_proxy api:3000
	}
	handle /health {
		reverse_proxy api:3000
	}
	handle /.well-known/oauth-protected-resource {
		reverse_proxy api:3000
	}
	handle {
		respond "Not Found" 404
	}
}

auth.brain.fi {
	import edge_security_headers

	reverse_proxy auth:3000
}
