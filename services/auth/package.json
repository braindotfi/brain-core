{
  "name": "@brain/auth",
  "version": "0.0.1",
  "private": true,
  "description": "OAuth 2.0 authorization server at AUTH_ISSUER. Phase 1: RFC 8414 metadata + JWKS discovery only.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src test --max-warnings 0",
    "lint:fix": "eslint src test --fix",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@brain/shared": "workspace:*",
    "@fastify/helmet": "^13.0.2",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2",
    "vitest": "^4.1.8"
  }
}
