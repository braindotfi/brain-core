{
  "name": "@brain/audit",
  "version": "0.0.5",
  "private": true,
  "description": "Append-only Merkle-chained log. On-chain anchor publisher via BrainAuditAnchor.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.11.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.8.1",
    "fast-check": "^4.9.0"
  },
  "dependencies": {
    "@brain/shared": "workspace:*",
    "fastify": "^5.11.0",
    "pg": "^8.22.0",
    "viem": "^2.55.11"
  }
}
